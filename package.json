{
  "name": "ai-shop-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "build:web": "vite build",
    "dev": "concurrently -k \"tsx watch src/server.ts\" \"vite\"",
    "start": "tsx src/server.ts",
    "preview": "npm run build:web && tsx src/server.ts",
    "test": "vitest run",
    "test:sheets": "tsx src/tests/sheetsConnection.ts",
    "test:gemini": "tsx src/tests/geminiConnection.ts",
    "test:claude": "tsx src/tests/claudeConnection.ts",
    "product:intake": "tsx src/cli.ts product:intake",
    "product:write": "tsx src/cli.ts product:write",
    "product:qa": "tsx src/cli.ts product:qa",
    "ceo:daily": "tsx src/cli.ts ceo:daily",
    "marketing:campaign": "tsx src/cli.ts marketing:campaign",
    "content:new-arrival": "tsx src/cli.ts content:new-arrival",
    "content:plan": "tsx src/cli.ts content:plan",
    "content:write": "tsx src/cli.ts content:write",
    "content:qa": "tsx src/cli.ts content:qa",
    "image:plan": "tsx src/cli.ts image:plan",
    "image:generate": "tsx src/cli.ts image:generate",
    "promo:suggest": "tsx src/cli.ts promo:suggest",
    "manager:final-check": "tsx src/cli.ts manager:final-check",
    "auto:once": "tsx src/cli.ts auto:once",
    "scheduler:start": "tsx src/cli.ts scheduler:start",
    "report:daily": "tsx src/cli.ts report:daily",
    "run:all": "tsx src/cli.ts run:all",
    "product:import": "tsx src/cli.ts product:import",
    "sales:import": "tsx src/cli.ts sales:import",
    "stock:import": "tsx src/cli.ts stock:import",
    "sheets:init": "tsx src/cli.ts sheets:init",
    "dry-run": "tsx src/cli.ts report:daily --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^9.1.3",
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^16.5.0",
    "fastify": "^5.5.0",
    "googleapis": "^173.0.0",
    "lucide-react": "^0.468.0",
    "node-cron": "^4.2.1",
    "pino": "^9.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.0.3"
  }
}
